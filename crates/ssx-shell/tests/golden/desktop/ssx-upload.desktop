[Desktop Entry]
# ssx-shell-managed: generated by ssx. Edits are overwritten; remove via ssx or delete this file.
Type=Application
Name=Upload with ssx
Comment=Upload the selected files with ssx
Exec=/usr/bin/ssx post-file -- %F
Icon=document-send
Terminal=false
StartupNotify=false
Categories=Utility;
MimeType=application/octet-stream;inode/directory;text/plain;application/pdf;application/zip;application/x-tar;application/gzip;application/json;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;image/png;image/jpeg;image/gif;image/webp;image/bmp;image/svg+xml;video/mp4;video/webm;video/x-matroska;audio/mpeg;audio/ogg;audio/flac;
