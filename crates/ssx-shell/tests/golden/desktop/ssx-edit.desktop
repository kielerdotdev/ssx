[Desktop Entry]
# ssx-shell-managed: generated by ssx. Edits are overwritten; remove via ssx or delete this file.
Type=Application
Name=Edit image with ssx
Comment=Open the selected image in the ssx editor
Exec=/usr/bin/ssx edit -- %f
Icon=applications-graphics
Terminal=false
StartupNotify=false
Categories=Utility;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/tiff;image/avif;image/heif;image/heic;
