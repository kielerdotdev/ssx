[Desktop Entry]
# ssx-shell-managed: generated by ssx. Edits are overwritten; remove via ssx or delete this file.
Type=Application
Name=Upload video with ssx
Comment=Upload the selected video with ssx
Exec=/usr/bin/ssx post-video -- %f
Icon=video-x-generic
Terminal=false
StartupNotify=false
Categories=Utility;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-ms-wmv;video/x-flv;video/x-m4v;video/ogg;video/mpeg;
