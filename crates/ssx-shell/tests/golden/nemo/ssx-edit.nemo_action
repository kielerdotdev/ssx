[Nemo Action]
# ssx-shell-managed: generated by ssx. Edits are overwritten; remove via ssx or delete this file.
Name=Edit image with ssx
Comment=Open the selected image in the ssx editor
Exec=/usr/bin/ssx edit -- %F
Icon-Name=applications-graphics
Selection=s
Extensions=.png;.jpg;.jpeg;.jpe;.gif;.webp;.bmp;.tif;.tiff;.avif;.heic;.heif;
Quote=single
