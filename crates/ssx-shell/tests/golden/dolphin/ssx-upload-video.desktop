[Desktop Entry]
# ssx-shell-managed: generated by ssx. Edits are overwritten; remove via ssx or delete this file.
Type=Service
MimeType=video/*;
Actions=ssxUploadVideo;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
X-KDE-Protocols=file
X-KDE-StartupNotify=false

[Desktop Action ssxUploadVideo]
Name=Upload video with ssx
Icon=video-x-generic
Exec=/usr/bin/ssx post-video -- %f
