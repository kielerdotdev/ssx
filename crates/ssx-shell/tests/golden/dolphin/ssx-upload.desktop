[Desktop Entry]
# ssx-shell-managed: generated by ssx. Edits are overwritten; remove via ssx or delete this file.
Type=Service
MimeType=all/all;
Actions=ssxUpload;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
X-KDE-Protocols=file
X-KDE-StartupNotify=false

[Desktop Action ssxUpload]
Name=Upload with ssx
Icon=document-send
Exec=/usr/bin/ssx post-file -- %F
