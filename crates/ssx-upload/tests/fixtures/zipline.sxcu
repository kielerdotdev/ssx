{
  "Version": "14.1.0",
  "Name": "Zipline v3",
  "DestinationType": "ImageUploader, TextUploader, FileUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://zipline.example.com/api/upload",
  "Headers": {
    "Authorization": "MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0.tokenpart",
    "Format": "RANDOM",
    "Embed": "true"
  },
  "Body": "MultipartFormData",
  "FileFormName": "file",
  "URL": "{json:files[0]}",
  "ErrorMessage": "{json:error}"
}
